knowledge_base_gestao_tempo:
  version: '1.0'
  tipo: Gestão de Tempo — Hábitos, Foco, Ritmo e Mordomia
  descricao: 'Base de conhecimento sobre gestão de tempo, hábitos, foco, ritmo e descanso.
    Metade geral (produtividade), metade cristã (mordomia, disciplinas espirituais).
    Apoia o especialista Kairos (gestor de tempo do TickTick) e embasa a skill kairos-gestao-tempo.
    Origem: solicitação via Kairos em 2026-09-11 (15 obras).

    '
  total_volumes: 17
  created_at: '2026-09-11'
  criado_por: bibliotecario
  origem: Z-Library (MCP zlib) — rodada automática de 2026-09-11
  destino: /dados/study-agent/data/biblioteca/gestao-tempo/
  politicas:
    idioma_preferencial: pt-BR quando canônica; EN quando único disponível
    formato_preferencial: epub > pdf > mobi (mobi só quando único disponível)
    backup_original: manter .epub/.pdf/.mobi junto ao .md (fonte de verdade)
  observacao_processamento: "Alguns PDFs do z-lib vieram corrompidos (xref/trailer\
    \ inválidos) — não foi possível\nextrair texto nem com markitdown nem com pdftotext.\
    \ Casos conhecidos:\n  - Wallace \"Greek Grammar Beyond the Basics\" (epub): markitdown\
    \ retornou vazio, .epub\n    perdido durante retry (script rm removeu antes de\
    \ confirmar conteúdo)\n  - Mounce \"Basics of Biblical Greek Grammar\" (pdf):\
    \ trailer/xref inválidos\n  - Covey \"Os 7 Hábitos\" (pdf): trailer/xref inválidos\n\
    Workaround aplicado para mobi (McKeown): kindleunpack + html parser → .md.\n"
