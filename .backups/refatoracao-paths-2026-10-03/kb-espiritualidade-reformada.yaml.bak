knowledge_base_espiritualidade_reformada:
  version: '1.0'
  tipo: Espiritualidade Reformada — Discipulado, Devoção e Formação Espiritual
  descricao: 'Base de conhecimento sobre espiritualidade reformada clássica — discipulado,
    práticas devocionais, formação espiritual. Complementa teologia reformada (kb-teologia-sistematica)
    com a dimensão vivencial/pessoal da fé.

    '
  total_volumes: 9
  created_at: 2026-09-13
  criado_por: bibliotecario
  origem: Z-Library (rodada de levantamento 2026-09-13)
  destino: /dados/study-agent/data/biblioteca/espiritualidade/
  observacoes:
  - KB nova criada a pedido do Willian ("Levante outras bases de conhecimentos")
  - Foco: estudo teológico pessoal (profundidade), formação devocional
  - Inclui clássicos da espiritualidade reformada (Bonhoeffer, Foster, Nouwen, Willard)
  - Complementa o que já tem em kb-vida-crista (Packer, Horton, Keller, etc.)
  materiais:
