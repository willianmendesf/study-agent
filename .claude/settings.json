{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v rtk >/dev/null 2>&1 && rtk hook claude || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/inventario-biblioteca.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/auto-pull-framework.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "L=\"$CLAUDE_PROJECT_DIR/.claude/skills/deja-search/bin/deja-run.sh\"; [ -f \"$L\" ] && sh \"$L\" hook-prompt || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "L=\"$CLAUDE_PROJECT_DIR/.claude/skills/deja-search/bin/deja-run.sh\"; [ -f \"$L\" ] && sh \"$L\" hook-context || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "L=\"$CLAUDE_PROJECT_DIR/.claude/skills/deja-search/bin/deja-run.sh\"; [ -f \"$L\" ] && sh \"$L\" hook-precompact || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false
}
